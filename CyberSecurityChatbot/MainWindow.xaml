<Window x:Class="CyberSecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Chatbot"
        Height="600" Width="800"
        Background="Beige">

    <TabControl x:Name="MainTabControl">

        <!-- Chat Tab -->
        <TabItem Header="Chat">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ASCII Art Display -->
                <TextBlock x:Name="AsciiArtDisplay"
                           Grid.Row="0"
                           TextAlignment="Center"
                           Foreground="Navy"
                           FontFamily="Consolas"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="10"/>

                <!-- Chat history inside scroll viewer -->
                <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                    <TextBlock x:Name="ChatDisplay"
                               TextWrapping="Wrap"
                               Foreground="Purple"
                               FontFamily="Segoe UI"
                               FontSize="14"/>
                </ScrollViewer>

                <!-- New Questions List -->
                <ListView x:Name="QuestionsList" Grid.Row="2" Margin="10" Height="120">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Segoe UI" FontSize="14" Foreground="Cyan"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Input row -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10">
                    <TextBox x:Name="UserInput"
                             Width="400"
                             FontFamily="Segoe UI"
                             FontSize="14"
                             Foreground="Black"
                             ToolTip="Enter message"/>
                    <Button x:Name="SendButton"
                            Content="Send"
                            Width="100"
                            Margin="10,0,0,0"
                            Background="DarkCyan"
                            Foreground="White"
                            FontWeight="Bold" Height="40"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="BackButton" Content="⬅️ Back" Width="100" Height="40" Margin="5" Background="DarkCyan" Foreground="White"/>
                        <Button x:Name="ExitButton" Content="❌ Exit" Width="100" Height="40" Margin="5" Background="DarkCyan" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- Task Assistant Tab -->
        <TabItem Header="Task Assistant">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="0">
                    <TextBox x:Name="TaskTitleBox" Width="150" ToolTip="Title" Margin="0,0,10,0"/>
                    <TextBox x:Name="TaskDescriptionBox" Width="200" ToolTip="Description" Margin="0,0,10,0"/>
                    <TextBox x:Name="TaskReminderBox" Width="150" ToolTip="Reminder"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="1">
                    <Button Content="Add Task" Click="AddTask_Click" Margin="0,0,10,0"/>
                    <Button Content="Complete Task" Click="CompleteTask_Click" Margin="0,0,10,0"/>
                    <Button Content="Delete Task" Click="DeleteTask_Click"/>
                </StackPanel>

                <ListView x:Name="TaskListView" Grid.Row="2">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="40"/>
                            <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="150"/>
                            <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="200"/>
                            <GridViewColumn Header="Reminder" DisplayMemberBinding="{Binding Reminder}" Width="150"/>
                            <GridViewColumn Header="Complete" DisplayMemberBinding="{Binding IsComplete}" Width="80"/>
                            <GridViewColumn Header="Created At" DisplayMemberBinding="{Binding CreatedAt}" Width="120"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </TabItem>

        <!-- Quiz Tab -->
        <TabItem Header="Quiz" x:Name="QuizTab">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Question -->
                    <RowDefinition Height="Auto"/>
                    <!-- Options -->
                    <RowDefinition Height="Auto"/>
                    <!-- Buttons -->
                    <RowDefinition Height="Auto"/>
                    <!-- Feedback -->
                    <RowDefinition Height="Auto"/>
                    <!-- Score -->
                    <RowDefinition Height="*"/>
                    <!-- Final Results -->
                </Grid.RowDefinitions>

                <!-- Current Question -->
                <TextBlock x:Name="QuizQuestionBlock"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"
                   Foreground="Navy"/>

                <!-- Answer Options -->
                <StackPanel x:Name="AnswerOptionsPanel"
                    Grid.Row="1"
                    Orientation="Vertical"
                    Margin="0,0,0,15">
                    <RadioButton x:Name="OptionA" Content="Option A" Visibility="Collapsed" GroupName="QuizOptions" Foreground="Black"/>
                    <RadioButton x:Name="OptionB" Content="Option B" Visibility="Collapsed" GroupName="QuizOptions" Foreground="Black"/>
                    <RadioButton x:Name="OptionC" Content="Option C" Visibility="Collapsed" GroupName="QuizOptions" Foreground="Black"/>
                    <RadioButton x:Name="OptionD" Content="Option D" Visibility="Collapsed" GroupName="QuizOptions" Foreground="Black"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                    <Button x:Name="SubmitAnswerButton" Content="Submit Answer" Click="SubmitAnswer_Click"
                    Width="120" Height="40" Margin="0,0,10,0"
                    Background="DarkCyan" Foreground="White" FontWeight="Bold"/>
                    <Button x:Name="NextQuestionButton" Content="Next Question" Click="NextQuestion_Click"
                    Width="120" Height="40" Visibility="Collapsed"
                    Background="DarkCyan" Foreground="White" FontWeight="Bold"/>
                    <Button x:Name="HintButton" Content="Hint" Click="HintButton_Click"
                    Width="80" Height="40" Margin="10,0,0,0"
                    Background="DarkCyan" Foreground="White" FontWeight="Bold"/>
                    <Button x:Name="RestartQuizButton" Content="Restart Quiz" Click="RestartQuiz_Click"
                    Width="120" Height="40" Margin="10,0,0,0"
                    Background="DarkCyan" Foreground="White" FontWeight="Bold"/>
                </StackPanel>

                <!-- Feedback Area -->
                <TextBlock x:Name="FeedbackBlock"
                   Grid.Row="3"
                   FontSize="14"
                   Foreground="Purple"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"/>

                <!-- Score Tracker -->
                <TextBlock x:Name="QuizScoreBlock"
                   Grid.Row="4"
                   FontSize="14"
                   FontWeight="Bold"
                   Foreground="DarkGreen"
                   Margin="0,0,0,15"/>

                <!-- Final Results -->
                <TextBlock x:Name="FinalResultsBlock"
                   Grid.Row="5"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="DarkRed"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
            </Grid>
        </TabItem>


    </TabControl>
</Window>
